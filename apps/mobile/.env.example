# On a real phone use your Mac LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Shows the dev login. The API must also run with DEV_AUTH=true.
EXPO_PUBLIC_DEV_AUTH=false

# Google Sign-In client ids (public, not secrets). Create them in Google Cloud > Credentials
# (see docs/OAUTH_SETUP.md). If a platform id is empty, the Google button explains it is not set up yet.
# iOS client (bundle id dev.urmirahman.authenticator). Keep the matching URL scheme in app.json in sync.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web client (same as the server's GOOGLE_CLIENT_ID). Makes the id_token audience the web client id.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android client (package name + SHA-1 of your signing key). Needed for Google sign-in on Android.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Public web app URL: legal, help and security pages open there (in-app browser).
EXPO_PUBLIC_WEB_URL=http://localhost:3001
