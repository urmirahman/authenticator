{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"Go function: no install step\"",
  "buildCommand": "echo \"Go function: Vercel builds api/index.go itself\"",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.go": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/v1/internal/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
