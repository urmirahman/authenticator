APP_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://authenticator:authenticator@localhost:5432/authenticator?sslmode=disable
ALLOWED_ORIGINS=http://localhost:3001

# openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Sign in with Apple: no static secret. We sign a JWT with this .p8 key (see pkg/applesecret).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Authenticator
WEBAUTHN_RP_ORIGINS=http://localhost:3001
