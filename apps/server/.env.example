APP_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://authenticator:authenticator@localhost:5433/authenticator?sslmode=disable
ALLOWED_ORIGINS=http://localhost:3001
# Where the browser may be sent after OAuth (prefix match, comma-separated).
ALLOWED_REDIRECTS=http://localhost:3001
# Local testing only: enables POST /v1/dev/token {"email": "..."} -> tokens. Refused in production.
DEV_AUTH=false

# openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS/Android OAuth client ids whose id_tokens we also accept (comma-separated).
GOOGLE_EXTRA_AUDIENCES=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Sign in with Apple: no static secret. We sign a JWT with this .p8 key (see pkg/applesecret).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 contents; keep the BEGIN/END lines (use \n or a quoted multi-line value).
APPLE_PRIVATE_KEY=
# The iOS bundle id, so native Sign in with Apple id_tokens are accepted.
APPLE_EXTRA_AUDIENCES=

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Authenticator
WEBAUTHN_RP_ORIGINS=http://localhost:3001
